# Copy to .env and fill in. Never commit .env.

# --- Flask ---
SECRET_KEY=change-me-to-a-long-random-string
SECURITY_PASSWORD_SALT=change-me-too
FLASK_DEBUG=false
# Public base URL used in emailed links (e.g. your ngrok or Render URL)
PUBLIC_BASE_URL=http://127.0.0.1:5000
# Display timezone offset from UTC in minutes (Nepal = 345)
UTC_OFFSET_MINUTES=345

# --- Database (relative sqlite paths live in instance/) ---
DATABASE_URL=sqlite:///lumora.db

# --- SMTP (Gmail needs an App Password) ---
MAIL_SERVER=smtp.gmail.com
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=
# Set to true to skip real email sending (links are logged instead)
MAIL_SUPPRESS_SEND=false

# --- Chatbot ---
INTENT_CONFIDENCE_THRESHOLD=0.55
LOAD_INTENT_MODEL=true
# Optional: generative fallback. Leave empty to run without it.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# --- Community ---
COMMUNITY_REPORT_THRESHOLD=3

# --- Consultation / Khalti sandbox (test keys from https://test-admin.khalti.com) ---
CONSULTATION_FEE_NPR=1500
KHALTI_SECRET_KEY=
KHALTI_BASE_URL=https://dev.khalti.com/api/v2

# --- Demo data (python seed.py) — local demo only ---
DEMO_PASSWORD=Lumora@2026
